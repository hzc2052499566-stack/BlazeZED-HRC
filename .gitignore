*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local Python environments and build products
.venv/
venv/
env/
build/
dist/
*.egg-info/

# IDE, agent, and machine-local state
.idea/
.vscode/
.agents/
/agents.md
/AGENTS.md
*.suo
*.user
*.code-workspace

# Machine-local launchers
/Start_Isaac_Sim_DX12.cmd
/Start_Isaac_Sim*.cmd
/start_isaac_sim*.cmd

# Generated experiment products and scratch space
/output/
/tmp/
/lab_session_*/
/captures/
/recordings/
/data/private/
artifacts.partial/
/tools/tr2_rep_*/
/tools/tr3_rep_*/
